generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("account_manager")
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  partner       Partner?
  camDeals       Deal[]          @relation("CamDeals")
  dealActivities DealActivity[]
  camAssignments CamAssignment[] @relation("CamAssignments")
  notifications  Notification[]
}

model Invite {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  role      String
  expiresAt DateTime
  partnerId String?
  createdAt DateTime @default(now())

  @@index([token])
}

model Partner {
  id                 String   @id @default(cuid())
  userId             String?  @unique
  slug               String   @unique
  name               String
  logo               String   @default("")
  coverImage         String   @default("")
  tagline            String
  description        String
  partnerType        String
  categories         String
  industries         String
  featuredWhops      String
  caseStudies        String
  reviews            String
  avgRating          Float    @default(0)
  reviewCount        Int      @default(0)
  priceRange         String
  location           String   @default("")
  timezone           String   @default("")
  languages          String
  responseTime       String
  contactEmail       String
  website            String   @default("")
  calendlyLink       String?
  internalNotes      String   @default("")
  internalTags       String
  whopContactPerson  String   @default("")
  lastEngagementDate String   @default("")
  recommendedFor     String
  tier               String   @default("Bronze")
  totalRevenue       Float    @default(0)
  totalDeals         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  deals          Deal[]
  camAssignments CamAssignment[]
  bountyProgress BountyProgress[]
}

model PartnerApplication {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  interest  String?
  createdAt DateTime @default(now())
}

model Deal {
  id                String    @id @default(cuid())
  name              String
  businessName      String
  businessContact   String    @default("")
  businessEmail     String    @default("")
  estimatedValue    Float
  monthlyProcessing Float     @default(0)
  probability       Int       @default(20)
  stage             String    @default("New Opportunity")
  notes             String    @default("")
  partnerId         String
  partner           Partner   @relation(fields: [partnerId], references: [id])
  camId             String?
  cam               User?     @relation("CamDeals", fields: [camId], references: [id])
  whopMerchantId    String?
  firstPaymentDate  DateTime?
  closedAt          DateTime?
  closedReason      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  activities        DealActivity[]
}

model DealActivity {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  type      String
  content   String
  createdAt DateTime @default(now())
}

model CamAssignment {
  id        String   @id @default(cuid())
  camId     String
  cam       User     @relation("CamAssignments", fields: [camId], references: [id])
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  createdAt DateTime @default(now())

  @@unique([camId, partnerId])
}

model Bounty {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String
  target      Float
  reward      String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  progress    BountyProgress[]
}

model BountyProgress {
  id        String   @id @default(cuid())
  bountyId  String
  bounty    Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  current   Float    @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([bountyId, partnerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
